{
  "manifest_version": 3,
  "name": "USCIS Case Viewer",
  "version": "1.0.0",
  "description": "Shows the full case details my.uscis.gov already has — exact timestamps, notices, event history and status flags.",
  "permissions": ["storage"],
  "host_permissions": ["https://my.uscis.gov/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "USCIS Case Viewer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://my.uscis.gov/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://my.uscis.gov/*"],
      "js": ["format.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://my.uscis.gov/*"],
      "js": ["panel.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
